From: Aldo Escobar <aoelvp94@users.noreply.github.com>
Date: Mon, 16 Nov 2026 14:42:53 +0400
Subject: [PATCH 2/2] Convert ADBC interval columns to durations for rows and
 polars

---
 src/sql/run/arrowcursor.py | 34 +++++++++++++++++++++++++++++++++-
 src/sql/run/resultset.py   |  7 +++----
 src/tests/test_adbc.py     | 22 +++++++++++++++++++++-
 3 files changed, 57 insertions(+), 6 deletions(-)

diff --git a/src/sql/run/arrowcursor.py b/src/sql/run/arrowcursor.py
index 86d48b9..5efd27c 100644
--- a/src/sql/run/arrowcursor.py
+++ b/src/sql/run/arrowcursor.py
@@ -1,3 +1,33 @@
+from datetime import timedelta
+
+
+def intervals_to_durations(table):
+    """
+    Convert month_day_nano_interval columns to duration[us] (a month counts as 30
+    days, like psycopg2 and duckdb do) since polars cannot import them and rows
+    would contain pyarrow MonthDayNano objects instead of timedelta
+    """
+    import pyarrow as pa
+
+    for i, field in enumerate(table.schema):
+        if field.type != pa.month_day_nano_interval():
+            continue
+        values = [
+            (
+                None
+                if v is None
+                else timedelta(
+                    days=v.months * 30 + v.days, microseconds=v.nanoseconds // 1000
+                )
+            )
+            for v in table.column(i).to_pylist()
+        ]
+        table = table.set_column(
+            i, field.with_type(pa.duration("us")), pa.array(values, pa.duration("us"))
+        )
+    return table
+
+
 class ArrowCursor:
     """
     Wraps an ADBC DBAPI cursor so results are read as Arrow record batches.
@@ -54,7 +84,9 @@ class ArrowCursor:
     def _rows(self, stop):
         if stop <= self._offset:
             return []
-        table = self._as_table().slice(self._offset, stop - self._offset)
+        table = intervals_to_durations(
+            self._as_table().slice(self._offset, stop - self._offset)
+        )
         self._offset = stop
         return list(zip(*(column.to_pylist() for column in table.columns)))
 
diff --git a/src/sql/run/resultset.py b/src/sql/run/resultset.py
index 77d325f..edaef13 100644
--- a/src/sql/run/resultset.py
+++ b/src/sql/run/resultset.py
@@ -11,7 +11,7 @@ import warnings
 from sql.column_guesser import ColumnGuesserMixin
 from sql.run.csv import CSVWriter, CSVResultDescriptor
 from sql.run.table import CustomPrettyTable
-from sql.run.arrowcursor import ArrowCursor
+from sql.run.arrowcursor import ArrowCursor, intervals_to_durations
 from sql._current import _config_feedback_all
 
 from sql.exceptions import RuntimeError
@@ -507,9 +507,8 @@ def _convert_to_data_frame(
     constructor_kwargs = constructor_kwargs or {}
 
     if converter_name == "pl" and isinstance(result_set.sqlaproxy, ArrowCursor):
-        return constructor(
-            result_set.sqlaproxy.fetch_arrow_table(), **constructor_kwargs
-        )
+        table = intervals_to_durations(result_set.sqlaproxy.fetch_arrow_table())
+        return constructor(table, **constructor_kwargs)
 
     # maybe create accessors in the connection objects?
     if result_set._conn.is_dbapi_connection:
diff --git a/src/tests/test_adbc.py b/src/tests/test_adbc.py
index d666ed5..722d8ec 100644
--- a/src/tests/test_adbc.py
+++ b/src/tests/test_adbc.py
@@ -1,7 +1,9 @@
+from datetime import timedelta
+
 import pytest
 
 from sql.connection import ADBCConnection, ConnectionManager, is_adbc
-from sql.run.arrowcursor import ArrowCursor
+from sql.run.arrowcursor import ArrowCursor, intervals_to_durations
 
 adbc_sqlite = pytest.importorskip("adbc_driver_sqlite.dbapi")
 pa = pytest.importorskip("pyarrow")
@@ -117,3 +119,21 @@ def test_arrow_cursor_fetch_methods():
 def test_resultset_arrow_table_non_adbc(ip_dbapi):
     table = ip_dbapi.run_cell("%sql SELECT * FROM test").result.ArrowTable()
     assert table.to_pydict() == {"n": [1, 2], "name": ["foo", "bar"]}
+
+
+def test_intervals_to_durations():
+    table = pa.table(
+        {
+            "iv": pa.array(
+                [pa.MonthDayNano([1, 2, 3_000_000_000]), None],
+                pa.month_day_nano_interval(),
+            )
+        }
+    )
+    out = intervals_to_durations(table)
+    assert out.schema.field("iv").type == pa.duration("us")
+    assert out.column("iv").to_pylist() == [
+        timedelta(days=32, seconds=3),
+        None,
+    ]
+    assert pl.from_arrow(out)["iv"].dtype == pl.Duration("us")
